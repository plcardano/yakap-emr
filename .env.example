# Copy to .env.local. Never commit real values.

# Matches docker-compose.yml. Development only.
DATABASE_URL=postgres://yakap:yakap_dev@127.0.0.1:5433/yakap

# Generate each with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
PIN_HMAC_KEY=

# Used by npm run db:seed to create the first facility and admin account.
SEED_FACILITY_ACCRE_NO=H12345678
SEED_FACILITY_NAME=Sample YAKAP Clinic
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
